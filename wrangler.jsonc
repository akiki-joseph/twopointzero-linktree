{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twopointzero-linktree",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "twopointzero-db",
      "database_id": "b56b9354-330d-49a9-902e-eb53989af9d5"
    }
  ],
  "observability": { "enabled": true }
}
